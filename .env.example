# Copy to .env and fill in. NEVER commit .env.

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# --- Data ---
# DATA_DIR=./data            # default: <repo>/data
# Session types shown by default in charts/backtests. Options:
#   normal, weekend_full, special_short, muhurat
INCLUDE_SESSION_TYPES=normal,weekend_full

# --- Safety ---
# Real orders are only possible in Phase 7 AND when this is true.
LIVE_TRADING=false

# --- Upstox market data (Phase 2a) ---
# Read-only Analytics Token (about 1 year). Used only for market data, never sent anywhere
# except Upstox, never logged. Generate it in the Upstox developer console.
UPSTOX_ANALYTICS_TOKEN=
# Optional: override the request caps (our own budget; Upstox allows 50/s, 500/min, 2000/30min
# and it is shared with other apps using the same account).
# UPSTOX_RATE_PER_SECOND=20
# UPSTOX_RATE_PER_MINUTE=300
# UPSTOX_RATE_PER_HALF_HOUR=1200
# Take the daily instrument snapshot at startup if today's is missing (default true).
# SNAPSHOT_ON_STARTUP=true

# --- Live feed (Phase 2b) ---
# Uses the same Analytics Token. ONE feed connection only (My Trading Desk may use the other).
# LIVE_FEED_ENABLED=true
# first_tick (default) | pre_open_inclusive: how the 09:15 bar's volume baseline is taken
# LIVE_OPEN_VOLUME_BASELINE=first_tick
# IST windows (HH:MM): connect, record (data/feed-recordings), daily reconcile
# LIVE_CONNECT_START=08:55
# LIVE_CONNECT_END=16:10
# LIVE_RECORD_START=09:00
# LIVE_RECORD_END=16:05
# LIVE_RECONCILE_AT=15:45
# LIVE_RECONCILE_UNTIL=16:30
# Record the nearest weekly's ATM±2 calls and puts (best bid/ask and a 1-lot / 2-lot
# fill through the 5-level book) into data/spreads/. Leave this off for the first live
# session; turn it on only after that session has run unchanged.
# SPREAD_RECORDER_ENABLED=false

# --- Upstox OAuth (Phase 7, NOT used yet) ---
# Needed only for orders / portfolio. Phase 2a has no OAuth and no order code.
# UPSTOX_API_KEY=
# UPSTOX_API_SECRET=
# UPSTOX_REDIRECT_URI=http://localhost:8000/api/auth/upstox/callback

# --- OpenAI (Phase 5) ---
OPENAI_API_KEY=
# Chart analysis model. Falls back to AI_MODEL, then gpt-4o-mini.
# AI_ANALYSIS_MODEL=
# Dollar amount on the panel only when BOTH rates are set. No rate is assumed.
# AI_ANALYSIS_INPUT_USD_PER_MTOK=
# AI_ANALYSIS_OUTPUT_USD_PER_MTOK=
# Moves inside this fraction of price are flat. Default 0.003 (0.3%).
# AI_ANALYSIS_NEUTRAL_BAND=0.003
